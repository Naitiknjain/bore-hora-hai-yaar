# Public Supabase settings (safe to expose to the browser).
# Leave empty to run the site in local-only mode (no shared leaderboards / recovery).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# NEVER put the service-role key or the Loop Sort admin PIN in a VITE_ variable.
# The admin PIN is set inside the database (see README -> "Loop Sort admin PIN").
